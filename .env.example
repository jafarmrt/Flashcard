# Gemini API key used when the app's AI settings have no key of their own
# (API_KEY is read too). Kept on the server, never sent to the browser.
GEMINI_API_KEY=

# Optional: Merriam-Webster keys (free at dictionaryapi.com), used when the
# key field in Settings > Dictionaries is empty. Collegiate, and Learner's.
MW_API_KEY=
MW_LEARNERS_API_KEY=

# Vercel only: Upstash Redis REST API. On a VPS leave empty and the data is
# kept in DATA_DIR/.data_store.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: e-mail sent to the free MyMemory translation API (raises its daily
# quota), used when the e-mail field in Settings > Dictionaries is empty
MYMEMORY_EMAIL=

# Signs the login cookie. On the VPS a random secret is kept in .session_secret
# when this is empty. Required on Vercel. At least 32 characters.
SESSION_SECRET=

# Empty: the first account can be created, and later ones cannot.
# true: anyone who opens the site can register. false: nobody can.
ALLOW_REGISTRATION=

# Where the server listens. On a VPS behind nginx use HOST=127.0.0.1 and a
# port no other app uses.
PORT=3000
HOST=0.0.0.0

# Folder for user data (.data_store.json) and .session_secret. Defaults to the
# app folder; on a VPS point it outside the code, e.g. /var/lib/flashcard.
DATA_DIR=
