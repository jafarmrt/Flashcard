# AI Studio Gemini API Key
GEMINI_API_KEY=

# Optional: Merriam-Webster Dictionary API Key
MW_API_KEY=

# Optional: Vercel KV REST API (In-memory fallback is active if omitted)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: e-mail sent to the free MyMemory translation API (raises its daily quota)
MYMEMORY_EMAIL=

# Signs the login cookie. On the VPS a random secret is kept in .session_secret
# when this is empty. Required on Vercel. At least 32 characters.
SESSION_SECRET=

# Set to false once your account exists so nobody else can register.
ALLOW_REGISTRATION=true

# Where the server listens. On a VPS behind nginx use HOST=127.0.0.1 and a
# port no other app uses.
PORT=3000
HOST=0.0.0.0

# Folder for user data (.data_store.json) and .session_secret. Defaults to the
# app folder; on a VPS point it outside the code, e.g. /var/lib/flashcard.
DATA_DIR=
