{
  "functions": {
    "api/proxy.ts": {
      "maxDuration": 60
    },
    "api/telegram.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/telegram?cron=1",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/telegram?cron=evening",
      "schedule": "30 15 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), camera=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
